name: Build APK

# Запускается кнопкой Run workflow на вкладке Actions или при каждой загрузке изменений в ветку main.
on:
  workflow_dispatch:
  push:
    branches: [main, master]

jobs:
  apk:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: 22

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: 21

      - uses: android-actions/setup-android@v3

      - name: Install dependencies
        run: npm install

      - name: Create Android project
        run: npx cap add android

      # Иконка и заставка из папки resources. Если шаг не сработает, APK соберётся со стандартной иконкой.
      - name: Generate icons
        continue-on-error: true
        run: npx @capacitor/assets generate --android --assetPath resources

      # Игра рассчитана на вертикальный экран.
      - name: Lock portrait orientation
        run: sed -i 's|<activity|<activity android:screenOrientation="portrait"|' android/app/src/main/AndroidManifest.xml

      - name: Sync web files
        run: npx cap sync android

      - name: Build debug APK
        working-directory: android
        run: |
          chmod +x gradlew
          ./gradlew assembleDebug

      - uses: actions/upload-artifact@v4
        with:
          name: bashnya-apk
          path: android/app/build/outputs/apk/debug/app-debug.apk
          if-no-files-found: error
